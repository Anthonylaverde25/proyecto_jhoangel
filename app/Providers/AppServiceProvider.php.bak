<?php

declare(strict_types=1);

namespace App\Providers;

use App\Core\Interfaces\ICaravanRepository;
use App\Core\Interfaces\IFieldMappingResolver;
use App\Core\Interfaces\IWorkdayRepository;
use App\Infrastructure\Persistence\EloquentCaravanRepository;
use App\Infrastructure\Persistence\EloquentPaternityRepository;
use App\Infrastructure\Persistence\EloquentFieldMappingResolver;
use App\Infrastructure\Persistence\EloquentWorkdayRepository;
use App\Core\Interfaces\ICompanyContext;
use App\Core\Interfaces\ICompanyRepository;
use App\Core\Interfaces\IBreedRepository;
use App\Core\Interfaces\IBatchTypeRepository;
use App\Core\Interfaces\IProviderRepository;
use App\Core\Interfaces\IFarmRepository;
use App\Core\Interfaces\IBatchRepository;
use App\Core\Interfaces\ICaravanLineageRepository;
use App\Core\Interfaces\IPaternityRepository;
use App\Infrastructure\Persistence\EloquentProviderRepository;
use App\Infrastructure\Persistence\EloquentFarmRepository;
use App\Infrastructure\Persistence\EloquentBatchRepository;
use App\Infrastructure\Persistence\EloquentCaravanLineageRepository;
use App\Core\Interfaces\ICaravanMovementRepository;
use App\Infrastructure\Persistence\EloquentCaravanMovementRepository;
use App\Core\Interfaces\IActivityRepository;
use App\Infrastructure\Persistence\EloquentActivityRepository;
use App\Core\Interfaces\ICaravanWeightRepository;
use App\Infrastructure\Persistence\EloquentCaravanWeightRepository;
use App\Core\Interfaces\IWeighingTypeRepository;
use App\Core\Interfaces\IWeighingOrderRepository;
use App\Infrastructure\Persistence\EloquentWeighingOrderRepository;
use App\Infrastructure\Persistence\EloquentWeighingTypeRepository;
use App\Core\Interfaces\IWorkTemplateRepository;
use App\Infrastructure\Persistence\EloquentWorkTemplateRepository;
use App\Core\Interfaces\IServiceOrderRepository;
use App\Infrastructure\Observers\CaravanBatchAssignmentObserver;
use App\Infrastructure\Observers\CaravanMovementServiceExposureObserver;
use App\Models\Caravan;
use App\Models\CaravanMovement;
use App\Infrastructure\Persistence\EloquentServiceOrderRepository;
use Illuminate\Support\ServiceProvider;

class AppServiceProvider extends ServiceProvider
{
    /**
     * Register any application services.
     */
    public function register(): void
    {
        $this->app->singleton(ICompanyContext::class, \App\Core\Contexts\CompanyContext::class);
        $this->app->bind(\App\Core\Interfaces\IAssistantGateway::class, \App\Infrastructure\Assistant\AiAgentAssistantGateway::class);
        $this->app->bind(\App\Core\Interfaces\IFiscalDocumentReader::class, \App\Infrastructure\OCR\AiAgentFiscalDocumentReader::class);
        $this->app->bind(\App\Core\Interfaces\IFiscalItemMatcher::class, \App\Infrastructure\OCR\AiAgentFiscalItemMatcher::class);
        $this->app->bind(\App\Core\Interfaces\IFiscalLineCatalogReader::class, \App\Infrastructure\Persistence\EloquentFiscalLineCatalogReader::class);
        $this->app->bind(ICaravanRepository::class, EloquentCaravanRepository::class);
        $this->app->bind(\App\Core\Interfaces\IDeathCauseRepository::class, \App\Infrastructure\Persistence\EloquentDeathCauseRepository::class);
        $this->app->bind(\App\Core\Interfaces\ICaravanDeathRepository::class, \App\Infrastructure\Persistence\EloquentCaravanDeathRepository::class);
        $this->app->bind(\App\Core\Interfaces\IBreedingEligibilityRepository::class, \App\Infrastructure\Persistence\EloquentBreedingEligibilityRepository::class);
        $this->app->bind(
            \App\Core\Interfaces\ICaravanRegistrationSubmissionRepository::class,
            \App\Infrastructure\Persistence\EloquentCaravanRegistrationSubmissionRepository::class
        );
        $this->app->bind(ICaravanLineageRepository::class, EloquentCaravanLineageRepository::class);
        $this->app->bind(IPaternityRepository::class, EloquentPaternityRepository::class);
        $this->app->bind(ICaravanWeightRepository::class, EloquentCaravanWeightRepository::class);
        $this->app->bind(IWeighingTypeRepository::class, EloquentWeighingTypeRepository::class);
        $this->app->bind(IWeighingOrderRepository::class, EloquentWeighingOrderRepository::class);
        $this->app->bind(IFieldMappingResolver::class, EloquentFieldMappingResolver::class);
        $this->app->bind(IWorkdayRepository::class, EloquentWorkdayRepository::class);
        $this->app->bind(IProviderRepository::class, EloquentProviderRepository::class);
        $this->app->bind(IFarmRepository::class, EloquentFarmRepository::class);
        $this->app->bind(IBatchRepository::class, EloquentBatchRepository::class);
        $this->app->bind(\App\Core\Interfaces\IBatchOverviewRepository::class, \App\Infrastructure\Persistence\EloquentBatchOverviewRepository::class);
        $this->app->bind(ICompanyRepository::class, \App\Infrastructure\Persistence\EloquentCompanyRepository::class);
        $this->app->bind(IBreedRepository::class, \App\Infrastructure\Persistence\EloquentBreedRepository::class);
        $this->app->bind(ICaravanMovementRepository::class, EloquentCaravanMovementRepository::class);
        $this->app->bind(IActivityRepository::class, EloquentActivityRepository::class);
        $this->app->bind(IWorkTemplateRepository::class, EloquentWorkTemplateRepository::class);
        $this->app->bind(IBatchTypeRepository::class, \App\Infrastructure\Persistence\EloquentBatchTypeRepository::class);
        $this->app->bind(IServiceOrderRepository::class, EloquentServiceOrderRepository::class);
        $this->app->bind(\App\Core\Interfaces\IServiceOrderIncidentRepository::class, \App\Infrastructure\Persistence\EloquentServiceOrderIncidentRepository::class);
        $this->app->bind(\App\Core\Interfaces\ITransferOrderRepository::class, \App\Infrastructure\Persistence\EloquentTransferOrderRepository::class);
        $this->app->bind(\App\Core\Interfaces\IWeaningOrderRepository::class, \App\Infrastructure\Persistence\EloquentWeaningOrderRepository::class);
        $this->app->bind(\App\Core\Interfaces\IWeaningOrderDeviationRepository::class, \App\Infrastructure\Persistence\EloquentWeaningOrderDeviationRepository::class);
        $this->app->bind(\App\Core\Interfaces\IEntryOrderRepository::class, \App\Infrastructure\Persistence\EloquentEntryOrderRepository::class);
        $this->app->bind(\App\Core\Interfaces\IBirthOrderRepository::class, \App\Infrastructure\Persistence\EloquentBirthOrderRepository::class);
        $this->app->bind(\App\Core\Interfaces\IAnimalCategoryRepository::class, \App\Infrastructure\Persistence\EloquentAnimalCategoryRepository::class);
        $this->app->bind(\App\Core\Interfaces\IPathogenRepository::class, \App\Infrastructure\Persistence\EloquentPathogenRepository::class);
        $this->app->bind(\App\Core\Interfaces\IVeterinaryDiagnosisRepository::class, \App\Infrastructure\Persistence\EloquentVeterinaryDiagnosisRepository::class);
        $this->app->bind(\App\Core\Interfaces\IBullHealthEvaluationRepository::class, \App\Infrastructure\Persistence\EloquentBullHealthEvaluationRepository::class);

        // Veterinary diagnostics module (hybrid sanitary architecture).
        $this->app->bind(\App\Core\Interfaces\IVeterinarianRepository::class, \App\Infrastructure\Persistence\EloquentVeterinarianRepository::class);
        $this->app->bind(\App\Core\Interfaces\IDiagnosticProtocolRepository::class, \App\Infrastructure\Persistence\EloquentDiagnosticProtocolRepository::class);
        $this->app->bind(\App\Core\Interfaces\ISampleShipmentRepository::class, \App\Infrastructure\Persistence\EloquentSampleShipmentRepository::class);
        $this->app->bind(\App\Core\Interfaces\IUserInvitationRepository::class, \App\Infrastructure\Persistence\EloquentUserInvitationRepository::class);
        $this->app->bind(\App\Core\Interfaces\IVeterinaryPortalAccessTokenRepository::class, \App\Infrastructure\Persistence\EloquentVeterinaryPortalAccessTokenRepository::class);

        // AI clients over MCP: connections, OAuth clients and codes, Sanctum-backed tokens.
        $this->app->bind(\App\Core\Interfaces\IMcpConnectionRepository::class, \App\Infrastructure\Persistence\EloquentMcpConnectionRepository::class);
        $this->app->bind(\App\Core\Interfaces\ITaskRepository::class, \App\Infrastructure\Persistence\EloquentTaskRepository::class);
        $this->app->bind(\App\Core\Interfaces\IMcpOAuthClientRepository::class, \App\Infrastructure\Persistence\EloquentMcpOAuthClientRepository::class);
        $this->app->bind(\App\Core\Interfaces\IMcpAuthorizationCodeRepository::class, \App\Infrastructure\Persistence\EloquentMcpAuthorizationCodeRepository::class);
        $this->app->bind(\App\Core\Interfaces\IMcpTokenGateway::class, \App\Infrastructure\Auth\SanctumMcpTokenGateway::class);
        $this->app->bind(\App\Core\Interfaces\ITenantDomains::class, \App\Infrastructure\Tenancy\StanclTenantDomains::class);
        $this->app->bind(\App\Core\Interfaces\IProtocolAttachmentStorage::class, \App\Infrastructure\Storage\LocalTenantAttachmentStorage::class);

        // ADR-12: extraction act numbers are minted by the system under a pessimistic lock.
        $this->app->bind(\App\Core\Interfaces\IProtocolNumberSequenceRepository::class, \App\Infrastructure\Persistence\EloquentProtocolNumberSequenceRepository::class);

        // One portal identity per request, populated by ResolveVeterinaryPortalAccess and read
        // by controllers and use cases through the Core interface.
        $this->app->scoped(\App\Infrastructure\Veterinary\VeterinaryPortalContext::class);
        $this->app->bind(
            \App\Core\Interfaces\IVeterinaryPortalContext::class,
            \App\Infrastructure\Veterinary\VeterinaryPortalContext::class
        );

        // ADR-4: the aptitude engine reads its thresholds from config/livestock.php, so the
        // sanitary rules stay auditable and adjustable without redeploying logic.
        $this->app->bind(
            \App\Core\Services\BullHealthEvaluationEngine::class,
            static fn (): \App\Core\Services\BullHealthEvaluationEngine => \App\Core\Services\BullHealthEvaluationEngine::fromConfig()
        );

        // The exposure risk window reaches back as far as a negative venereal result is valid.
        $this->app->bind(
            \App\Core\Services\SanitaryExposureResolver::class,
            static fn (): \App\Core\Services\SanitaryExposureResolver => new \App\Core\Services\SanitaryExposureResolver(
                (int) config('livestock.venereal.validity_days', 365)
            )
        );
        $this->app->bind(
            \App\Core\Interfaces\ISanitaryExposureRepository::class,
            \App\Infrastructure\Persistence\EloquentSanitaryExposureRepository::class
        );

        // Company item catalog (B1): units, categories, items and the base catalog.
        $this->app->bind(\App\Core\Interfaces\IUnitOfMeasureRepository::class, \App\Infrastructure\Persistence\EloquentUnitOfMeasureRepository::class);
        $this->app->bind(\App\Core\Interfaces\IItemCategoryRepository::class, \App\Infrastructure\Persistence\EloquentItemCategoryRepository::class);
        $this->app->bind(\App\Core\Interfaces\IItemRepository::class, \App\Infrastructure\Persistence\EloquentItemRepository::class);
        $this->app->bind(\App\Core\Interfaces\ICompanyItemCatalogRepository::class, \App\Infrastructure\Persistence\EloquentCompanyItemCatalogRepository::class);

        // Provider documents and stock (Entrega B2).
        $this->app->bind(\App\Core\Interfaces\IFiscalCatalogRepository::class, \App\Infrastructure\Persistence\EloquentFiscalCatalogRepository::class);
        $this->app->bind(\App\Core\Interfaces\IFiscalDocumentRepository::class, \App\Infrastructure\Persistence\EloquentFiscalDocumentRepository::class);
        $this->app->bind(\App\Core\Interfaces\IWarehouseRepository::class, \App\Infrastructure\Persistence\EloquentWarehouseRepository::class);
        // Semen S-A: sires, straw profiles, lots and straws without lot.
        $this->app->bind(\App\Core\Interfaces\ISemenSireRepository::class, \App\Infrastructure\Persistence\EloquentSemenSireRepository::class);
        $this->app->bind(\App\Core\Interfaces\ISemenProfileRepository::class, \App\Infrastructure\Persistence\EloquentSemenProfileRepository::class);
        $this->app->bind(\App\Core\Interfaces\ISemenLotRepository::class, \App\Infrastructure\Persistence\EloquentSemenLotRepository::class);
        $this->app->bind(\App\Core\Interfaces\ISemenUnidentifiedRepository::class, \App\Infrastructure\Persistence\EloquentSemenUnidentifiedRepository::class);
        $this->app->bind(\App\Core\Interfaces\IServiceOrderInseminationRepository::class, \App\Infrastructure\Persistence\EloquentServiceOrderInseminationRepository::class);
        $this->app->bind(\App\Core\Interfaces\ISemenInventoryReader::class, \App\Infrastructure\Persistence\EloquentSemenInventoryReader::class);
        $this->app->bind(\App\Core\Interfaces\IItemDocumentRepository::class, \App\Infrastructure\Persistence\EloquentItemDocumentRepository::class);
        $this->app->bind(\App\Core\Interfaces\IItemStockRepository::class, \App\Infrastructure\Persistence\EloquentItemStockRepository::class);
        $this->app->bind(\App\Core\Interfaces\IStockIncidentRepository::class, \App\Infrastructure\Persistence\EloquentStockIncidentRepository::class);
        $this->app->bind(\App\Core\Interfaces\IUnvaluedLotRepository::class, \App\Infrastructure\Persistence\EloquentUnvaluedLotRepository::class);
        $this->app->bind(\App\Core\Interfaces\IFiscalDiscrepancyRepository::class, \App\Infrastructure\Persistence\EloquentFiscalDiscrepancyRepository::class);
        $this->app->bind(\App\Core\Interfaces\IItemUsageReader::class, \App\Infrastructure\Persistence\EloquentItemUsageReader::class);
        $this->app->bind(\App\Core\Interfaces\IConsumableBatchReader::class, \App\Infrastructure\Persistence\EloquentConsumableBatchReader::class);
    }

    /**
     * Bootstrap any application services.
     */
    public function boot(): void
    {
        CaravanMovement::observe(CaravanMovementServiceExposureObserver::class);
        Caravan::observe(CaravanBatchAssignmentObserver::class);
        // Every company is born with its base units and categories (DB6).
        \App\Models\Company::observe(\App\Infrastructure\Observers\CompanyItemCatalogObserver::class);
    }
}

